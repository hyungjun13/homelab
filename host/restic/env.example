# Template for /etc/restic/env (chmod 600). Real values never get committed.
# Keep the single quotes: the Kuma URL contains '&', which bash would
# otherwise treat as a command separator.
RESTIC_REPOSITORY='s3:https://<endpoint>/<bucket>/homeserver'
RESTIC_PASSWORD_FILE='/etc/restic/password'
AWS_ACCESS_KEY_ID='<B2 keyID>'
AWS_SECRET_ACCESS_KEY='<B2 applicationKey>'
# Uptime Kuma Push monitor URL, e.g.
# 'http://127.0.0.1:3001/api/push/<token>?status=up&msg=OK&ping='
KUMA_PUSH_URL=''
